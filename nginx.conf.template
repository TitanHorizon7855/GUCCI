worker_processes 1;
events { worker_connections 1024; }

http {
    # ارتقای اتصال WebSocket
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # پروتکل واقعی: اگر Railway (یا پروکسی جلویی) هدر X-Forwarded-Proto را فرستاده
    # (مثلاً https) آن را حفظ کن، وگرنه از scheme اتصال استفاده کن
    map $http_x_forwarded_proto $real_scheme {
        default $http_x_forwarded_proto;
        ''      $scheme;
    }

    tcp_nodelay on;

    # ================= سرور اصلی: فقط پورت 1 =================
    server {
        listen 1;
        # ریدایرکت‌ها نسبی بمانند تا پورت داخلی لو نرود
        absolute_redirect off;

        # ریشه دامنه -> صفحه کاملاً سیاه (پنل و ساب مخفی می‌مانند)
        location = / {
            default_type text/html;
            return 200 '<!DOCTYPE html><html><head><title></title></head><body style="margin:0;padding:0;background:#000000;width:100vw;height:100vh;"></body></html>';
        }

        # /sub بدون اسلش -> صفحه سیاه (لینک خراب/ناقص)
        location = /sub {
            default_type text/html;
            return 200 '<!DOCTYPE html><html><head><title></title></head><body style="margin:0;padding:0;background:#000000;width:100vw;height:100vh;"></body></html>';
        }

        # /gucci بدون اسلش -> ریدایرکت به /gucci/
        location = /gucci {
            return 301 /gucci/;
        }

        # پنل 3x-ui -> پورت داخلی 2053 (فقط با مسیر /gucci/ باز می‌شود)
        location /gucci/ {
            proxy_pass http://127.0.0.1:2053/gucci/;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

        # سابسکریپشن (سرویس ساب روی پورت داخلی 443)
        # لینک اصلی: https://{دامنه‌ی پنل}/sub/{subId}
        # اگر subId اشتباه/کم و زیاد شود -> صفحه سیاه با وضعیت 200
        location /sub/ {
            proxy_pass http://127.0.0.1:443/sub/;
            proxy_http_version 1.1;
            proxy_intercept_errors on;
            error_page 400 404 502 503 504 =200 @subblack;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

        # صفحه سیاه برای لینک ساب اشتباه/ناقص
        location @subblack {
            default_type text/html;
            return 200 '<!DOCTYPE html><html><head><title></title></head><body style="margin:0;padding:0;background:#000000;width:100vw;height:100vh;"></body></html>';
        }

        # 📊 داشبورد ضریب مصرف کاربران (GUCCI Ratio) — با Basic-Auth
        location = /ratio {
            return 301 /ratio/;
        }
        location /ratio/ {
            auth_basic "GUCCI Ratio";
            auth_basic_user_file /etc/nginx/.htpasswd_ratio;
            alias /var/www/ratio/;
            index index.html;
        }

        # ساب Clash
        location /clash/ {
            proxy_pass http://127.0.0.1:443/clash/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }

__INBOUND_LOCATIONS__

        # اینباند اصلی VLESS/WebSocket -> پورت داخلی 8080
        # هر مسیری که به لوکیشن‌های بالا نخورد (مثلاً /cdn) به اینباند اصلی می‌رسد
        location / {
            proxy_pass http://127.0.0.1:8080;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $real_scheme;
        }
    }

__HOST_ROUTE_SERVERS__
}
